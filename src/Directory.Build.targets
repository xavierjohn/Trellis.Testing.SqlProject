<Project>

  <!--
    Icon and listing README for every packable project.

    This lives in Directory.Build.targets rather than Directory.Build.props on purpose. Props is
    imported before the project body, so $(IsPackable) is still empty there and the condition below
    could not distinguish the test project from a shipping one. Targets is imported after the body,
    where IsPackable has its final value.

    The README include is guarded by Exists() so a project without one does not fail on a missing
    item. Pack still fails loudly with NU5039 in that case, because PackageReadmeFile is declared
    unconditionally in Directory.Build.props: a package with no listing README should not ship.
  -->
  <ItemGroup Condition=" '$(IsPackable)' != 'false' ">
    <None Include="$(MSBuildThisFileDirectory)../icon.png"
          Pack="true"
          PackagePath="/" />
    <None Include="$(MSBuildProjectDirectory)/README.md"
          Condition=" Exists('$(MSBuildProjectDirectory)/README.md') "
          Pack="true"
          PackagePath="/" />
  </ItemGroup>

</Project>
